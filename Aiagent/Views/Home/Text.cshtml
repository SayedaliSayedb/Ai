@{
    ViewData["Title"] = "پرسش از هوش مصنوعی";
}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg">
                <div class="card-header bg-success text-white text-center">
                    <h2>💬 چت با هوش مصنوعی</h2>
                </div>
                <div class="card-body">
                    <form id="textForm">
                        <div class="mb-3">
                            <label for="systemPrompt" class="form-label">دستور سیستم (اختیاری):</label>
                            <input type="text" class="form-control" id="systemPrompt" placeholder="مثلاً: شما یک دستیار مفید هستید">
                        </div>
                        <div class="mb-3">
                            <label for="prompt" class="form-label">سوال خود را وارد کنید:</label>
                            <textarea class="form-control" id="prompt" rows="3" required></textarea>
                        </div>
                        <button type="submit" class="btn btn-success w-100" id="askBtn">
                            <span id="btnText">🚀 ارسال سوال</span>
                            <span id="btnSpinner" class="spinner-border spinner-border-sm d-none" role="status"></span>
                        </button>
                    </form>

                    <div id="resultContainer" class="mt-4 d-none">
                        <div class="alert alert-info" id="statusMessage">در حال پردازش...</div>
                        <div id="resultContent" class="mt-3"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let taskId = null;
        let pollingInterval = null;

        document.getElementById('textForm').addEventListener('submit', async function (e) {
            e.preventDefault();

            const prompt = document.getElementById('prompt').value;
            const systemPrompt = document.getElementById('systemPrompt').value;
            const btn = document.getElementById('askBtn');
            const btnText = document.getElementById('btnText');
            const spinner = document.getElementById('btnSpinner');

            if (!prompt.trim()) {
                alert('لطفاً یک سوال وارد کنید.');
                return;
            }

            btn.disabled = true;
            btnText.textContent = 'در حال ارسال...';
            spinner.classList.remove('d-none');

            const formData = new FormData();
            formData.append('prompt', prompt);
            formData.append('systemPrompt', systemPrompt);

            try {
                const response = await fetch('/ask-text', {
                    method: 'POST',
                    body: formData
                });

                if (!response.ok) {
                    const errorText = await response.text();
                    throw new Error(errorText || 'خطا در ارسال سوال');
                }

                const data = await response.json();
                taskId = data.taskId;

                document.getElementById('resultContainer').classList.remove('d-none');
                document.getElementById('statusMessage').textContent = '⏳ سوال دریافت شد. در حال پردازش...';
                document.getElementById('statusMessage').className = 'alert alert-warning';
                document.getElementById('resultContent').innerHTML = '';

                startPolling(taskId);

                btnText.textContent = '✅ سوال ارسال شد';
                spinner.classList.add('d-none');

            } catch (error) {
                alert('خطا: ' + error.message);
                btn.disabled = false;
                btnText.textContent = '🚀 ارسال سوال';
                spinner.classList.add('d-none');
            }
        });

        function startPolling(id) {
            pollingInterval = setInterval(async () => {
                try {
                    const response = await fetch(`/text-status/${id}`);
                    if (!response.ok) {
                        if (response.status === 404) {
                            clearInterval(pollingInterval);
                            document.getElementById('statusMessage').textContent = '❌ تسک پیدا نشد.';
                            document.getElementById('statusMessage').className = 'alert alert-danger';
                        }
                        return;
                    }

                    const data = await response.json();
                    const statusMessage = document.getElementById('statusMessage');
                    const resultContent = document.getElementById('resultContent');

                    switch (data.status) {
                        case 0: // Queued
                            statusMessage.textContent = '⏳ در صف انتظار...';
                            statusMessage.className = 'alert alert-secondary';
                            break;
                        case 1: // Processing
                            statusMessage.textContent = '🔄 در حال تولید پاسخ...';
                            statusMessage.className = 'alert alert-info';
                            break;
                        case 2: // Completed
                            statusMessage.textContent = '✅ پاسخ دریافت شد!';
                            statusMessage.className = 'alert alert-success';
                            clearInterval(pollingInterval);

                            if (data.result) {
                                try {
                                    const resultObj = JSON.parse(data.result);
                                    if (resultObj.Response) {
                                        resultContent.innerHTML = `<div class="card"><div class="card-body"><h5>پاسخ هوش مصنوعی:</h5><p class="lead">${resultObj.Response}</p></div></div>`;
                                    } else {
                                        resultContent.innerHTML = `<pre class="bg-light p-3 rounded">${JSON.stringify(resultObj, null, 2)}</pre>`;
                                    }
                                } catch {
                                    resultContent.innerHTML = `<div class="alert alert-success">${data.result}</div>`;
                                }
                            } else {
                                resultContent.innerHTML = '<div class="alert alert-warning">پاسخ دریافت نشد.</div>';
                            }

                            document.getElementById('askBtn').disabled = false;
                            document.getElementById('btnText').textContent = '🚀 سوال جدید';
                            break;
                        case 3: // Failed
                            statusMessage.textContent = '❌ خطا در تولید پاسخ';
                            statusMessage.className = 'alert alert-danger';
                            clearInterval(pollingInterval);
                            resultContent.innerHTML = `<div class="alert alert-danger">${data.errorMessage || 'خطای ناشناخته'}</div>`;
                            document.getElementById('askBtn').disabled = false;
                            document.getElementById('btnText').textContent = '🚀 ارسال سوال';
                            break;
                    }
                } catch (error) {
                    console.error('خطا در دریافت وضعیت:', error);
                }
            }, 2000);
        }
    </script>
}